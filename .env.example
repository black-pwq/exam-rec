# Network settings used by Docker Compose.
EXAM_REC_BIND_IP=127.0.0.1
EXAM_REC_PORT=8080

# Required LLM settings.
EXAM_REC_LLM_API_KEY=replace-with-the-LLM-api-key
EXAM_REC_LLM_BASE_URL=https://api.deepseek.com
EXAM_REC_LLM_MODEL=deepseek-v4-flash

# Application limits.
EXAM_REC_MAX_UPLOAD_BYTES=524288000
EXAM_REC_MAX_PDF_PAGES=500
EXAM_REC_MAX_QUEUED_JOBS=32
EXAM_REC_LOG_LEVEL=INFO

# CPU-only tuning. This value is harmless in the GPU deployment.
PADDLE_PDX_CPU_NUM_THREADS=4
